        inputs="fama_french_daily_factors",
        formula=f"pass_through({original_name})",
        leakage_policy="uses_dates_<=t_only",
    )

# ============================================
# PRINT OUTPUT SHAPES FOR QUICK NOTEBOOK AUDIT
# ============================================
